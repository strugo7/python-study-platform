 </div><div class="info-item"><strong>ציון מקסימלי:</strong><span>100 נקודות</span></div></div><div class="progress-bar"><div class="progress-fill" id="progressBar"></div></div><div class="content"><div id="questionsContainer"></div><div class="submit-section"><button class="btn" id="submitBtn">בדוק תשובות</button></div><div id="resultsSection" class="hidden"></div></div></div><script>const questions=[ {
