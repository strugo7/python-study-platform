let userAnswers=new Array(questions.length).fill(null);
let submitted=false;

function renderQuestions() {
    const container=document.getElementById('questionsContainer');

    questions.forEach((q, index)=> {
            const card=document.createElement('div');
            card.className='question-card';

            card.style.animationDelay=`$ {
                index * 0.05
            }

            s`;

            let html=` <div class="question-header" > <div class="question-number" >$ {
                q.number
            }

            </div> <div class="question-text" >$ {
                q.text
            }

            </div> </div> `;

            if (q.code) {
                html +=`<div class="code-block" >$ {
                    escapeHtml(q.code)
                }

                </div>`;
            }

            html +='<div class="options">';

            q.options.forEach((option, optIndex)=> {
                    html +=` <div class="option" data-question="${index}" data-option="${optIndex}" > <input type="radio" name="q${index}" id="q${index}_${optIndex}" value="${optIndex}" > <label for="q${index}_${optIndex}" >$ {
                        String.fromCharCode(97 + optIndex)
                    }

                    . $ {
                        option
                    }

                    </label> </div> `;
                });
            html +='</div>';

            card.innerHTML=html;
            container.appendChild(card);
        });

    document.querySelectorAll('.option').forEach(opt=> {
            opt.addEventListener('click', function() {
                    if (submitted) return;

                    const qIndex=parseInt(this.dataset.question);
                    const optIndex=parseInt(this.dataset.option);
                    const radio=this.querySelector('input[type="radio"]');
                    radio.checked=true;

                    this.parentElement.querySelectorAll('.option').forEach(o=> {
                            o.classList.remove('selected');
                        });
                    this.classList.add('selected');

                    userAnswers[qIndex]=optIndex;
                    updateProgress();
                });
        });
}

function updateProgress() {
    const answered=userAnswers.filter(a=> a !==null).length;
    const percentage=(answered / questions.length) * 100;
    document.getElementById('progressBar').style.width=percentage+'%';
}

function escapeHtml(text) {
    const div=document.createElement('div');
    div.textContent=text;
    return div.innerHTML;
}

function submitExam() {
    if (submitted) return;

    const unanswered=userAnswers.filter(a=> a===null).length;

    if (unanswered > 0) {
        if ( !confirm(`יש לך $ {
                    unanswered
                }

                שאלות ללא תשובה. האם אתה בטוח שאתה רוצה לשלוח?`)) {
            return;
        }
    }

    submitted=true;
    document.getElementById('submitBtn').disabled=true;
    document.getElementById('submitBtn').textContent='המבחן נבדק';

    let correct=0;

    document.querySelectorAll('.question-card').forEach((card, qIndex)=> {
            const options=card.querySelectorAll('.option');
            const correctAnswer=questions[qIndex].correct;
            const userAnswer=userAnswers[qIndex];

            options.forEach((opt, optIndex)=> {
                    if (optIndex===correctAnswer) {
                        opt.classList.add('correct');
                    }

                    if (userAnswer !==null && optIndex===userAnswer && userAnswer !==correctAnswer) {
                        opt.classList.add('incorrect');
                    }
                });

            if (userAnswer===correctAnswer) {
                correct++;
            }
        });

    showResults(correct);
}

function showResults(correct) {
    const score=Math.round((correct / questions.length) * 100);
    const percentage=(correct / questions.length) * 100;
    const wrong=questions.length - correct - userAnswers.filter(a=> a===null).length;
    const unanswered=userAnswers.filter(a=> a===null).length;

    let grade='';
    if (percentage >=90) grade='מצוין! 🐢';
    else if (percentage >=80) grade='טוב מאוד! 👏';
    else if (percentage >=70) grade='יפה! 👍';
    else if (percentage >=60) grade='עבר ✓';
    else grade='צריך לשפר 📚';

    const resultsHtml=` <div class="results"><div class="score-circle"><div class="score-number">$ {
        score
    }

    </div><div class="score-label">מתוך 100</div></div><h2>$ {
        grade
    }

    </h2><div class="results-details"><div class="result-stat"><div class="result-stat-value" style="color: #10b981;">$ {
        correct
    }

    </div><div class="result-stat-label">תשובות נכונות</div></div><div class="result-stat"><div class="result-stat-value" style="color: #ef4444;">$ {
        wrong
    }

    </div><div class="result-stat-label">תשובות שגויות</div></div><div class="result-stat"><div class="result-stat-value" style="color: #f59e0b;">$ {
        unanswered
    }

    </div><div class="result-stat-label">לא נענו</div></div></div><div class="share-section"><p style="color: var(--text-light); margin-bottom: 1rem;">שתף את התוצאה שלך עם חברים !</p><button class="share-btn" onclick="shareResults(${score})">📱 שתף בווטסאפ</button><button class="share-btn" onclick="copyResults(${score})">📋 העתק קישור</button></div></div>`;

    document.getElementById('resultsSection').innerHTML=resultsHtml;
    document.getElementById('resultsSection').classList.remove('hidden');

    document.getElementById('resultsSection').scrollIntoView({
        behavior: 'smooth', block: 'nearest'
    });
}

function shareResults(score) {
    const text=`סיימתי מבחן Turtle Graphics & Pickling וקיבלתי $ {
        score
    }

    /100 ! 🐢`;
    const url=`https: //wa.me/?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank');
}

function copyResults(score) {
    const text=`סיימתי מבחן Turtle Graphics & Pickling וקיבלתי $ {
        score
    }

    /100 ! 🐢`;
    navigator.clipboard.writeText(text).then(()=> {
            alert('הועתק ללוח! ✓');
        });
}

renderQuestions();
document.getElementById('submitBtn').addEventListener('click', submitExam);
</script></body></html>